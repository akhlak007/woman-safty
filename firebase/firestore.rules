rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    function isResponder() {
      return isAuthenticated() && (request.auth.token.responder == true || isAdmin());
    }

    // User profiles
    match /users/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isResponder());
      allow create, update: if isOwner(userId);
      allow delete: if isAdmin();

      // Subcollection: Emergency contacts
      match /contacts/{contactId} {
        allow read: if isAuthenticated() && (isOwner(userId) || isResponder());
        allow write: if isOwner(userId);
      }
    }

    // Emergencies: active emergency cases
    match /emergencies/{emergencyId} {
      // Emergency can be read by the creator, responders, or verified contacts
      allow read: if isAuthenticated();
      // Only authenticated users can trigger an emergency for themselves
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      // Updates allowed by owner or responders (status updates / triage answers)
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isResponder()
      );
      allow delete: if isAdmin();

      // Alerts subcollection (managed primarily by Cloud Functions)
      match /alerts/{alertId} {
        allow read: if isAuthenticated();
        allow write: if false; // Only Cloud Functions (Admin SDK) writes alerts
      }
    }

    // Ambulance requests (simulated partner flow)
    match /ambulanceRequests/{requestId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isResponder();
      allow delete: if isAdmin();
    }

    // Incident reports (harassment, stalking, threats)
    match /incidentReports/{reportId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(resource.data.userId);
      allow delete: if isAdmin();
    }

    // Hospital directory cache (read-only for clients)
    match /hospitals/{hospitalId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Aggregated analytics (read by admin, written by Cloud Functions)
    match /analytics/{docId} {
      allow read: if isAdmin();
      allow write: if false; // Only Cloud Functions (Admin SDK)
    }
  }
}
